      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "let request={};let scheduled=true;try {request=$('When Called').first().json;scheduled=false;}catch{}\nconst state=$input.all().map(item=>item.json).find(row=>row.monitor_key==='openrouter')||{};\nreturn [{json:{...request,is_scheduled:scheduled,monitor_state:state,threshold_usd:Number(state.threshold_usd??5)}}];"
      }
    },
