        720,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Check the card every two hours in the 72 hours before the event, so last-minute changes land before\n// new picks are extracted. Skip while an analysis run is checking the same card.\nconst events=$('Get Active UFC Event').all().map(i=>i.json).filter(e=>e.event_key);\nif(events.length!==1)return [];\nconst event=events[0];\nconst now=Date.now(),start=Date.parse(event.event_datetime_local);\nif(!Number.isFinite(start)||start<=now||start-now>72*3600e3)return [];\nconst busy=$('Get Running Analysis').all().map(i=>i.json).some(r=>r.state==='running'&&now-Date.parse(r.started_at)<3600e3);\nif(busy)return [];\nreturn [{json:event}];"
      }
    },
