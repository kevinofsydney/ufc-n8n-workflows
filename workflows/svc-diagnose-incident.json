      "parameters": {
        "jsCode": "// The AI step runs once per incident; with nothing to diagnose, nothing runs after this.\nconst p=$input.first().json;\nconst dry=$('When Called').first().json.dry_run===true;\nreturn (p.incidents||[]).map(i=>({json:{...i,dry_run:dry}}));"
      }
